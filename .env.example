# Copy to .env for local development. Values here are for the local Docker services only.

# Owner role; used by Alembic to run migrations and by the seed.
DATABASE_URL=postgresql+psycopg://cornerpin:cornerpin@localhost:5434/cornerpin
# Non-owner role the API connects as (ADR-021). Locally the migration sets this password.
API_DATABASE_URL=postgresql+psycopg://cornerpin_api:cornerpin_api@localhost:5434/cornerpin

# Mailpit (compose.yaml)
SMTP_HOST=localhost
SMTP_PORT=1025

# Web app -> API
API_BASE_URL=http://localhost:8000

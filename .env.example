# Copy to .env for local development. Values here are for the local Docker services only.

# Owner role; used by Alembic to run migrations and by the seed.
DATABASE_URL=postgresql+psycopg://cornerpin:cornerpin@localhost:5434/cornerpin
# Non-owner role the API connects as (ADR-021). Locally the migration sets this password.
API_DATABASE_URL=postgresql+psycopg://cornerpin_api:cornerpin_api@localhost:5434/cornerpin

# The origin people use. Sign-in links and the API's Origin check use it.
WEB_ORIGIN=http://localhost:3300
# Signs OAuth state. Any value locally; required and secret elsewhere.
SECRET_KEY=local-development-only-not-a-secret

# Cloudflare's always-pass Turnstile test keys; refused outside local.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google sign-in stays off until both exist (ADR-008).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: smtp (Mailpit, compose.yaml) locally; resend in the cloud.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
# Replies to outreach (ADR-037). With a domain, outreach emails reply to reply+...@<domain>;
# locally, paste that address into POST /v1/dev/inbound-email to play a buyer's reply. The
# webhook secret is Resend's, for production only.
INBOUND_EMAIL_DOMAIN=reply.cornerpin.test
RESEND_WEBHOOK_SECRET=

# The outreach agent (ADR-038) stays off until the key is set. It is pay as you go (about two
# cents a reply on the default model). Locally a short delay makes the first follow-up quick
# to see in Mailpit.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_FOLLOW_UP_MINUTES=1

# Slack (ADR-040) stays off until Cornerpin's Slack app's three values are set; then the
# Integrations page offers "Add to Slack" (which only completes over HTTPS, so on cornerpin.app).
# Locally, connect a tenant to a webhook made by hand: POST /v1/dev/integrations/slack.
# INTEGRATIONS_KEY seals tenants' credentials; locally a built-in key is used when it's empty.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# INTEGRATIONS_KEY=

# Uploaded photos and documents (ADR-025): local writes under var/storage; gcs needs a bucket.
STORAGE_BACKEND=local
STORAGE_BUCKET=

# Outbox (ADR-029): inprocess runs it inside the API (local). cloudtasks needs the three
# settings below and is for the cloud (P1-12).
OUTBOX_RUNNER=inprocess
CLOUD_TASKS_QUEUE=
INTERNAL_BASE_URL=
TASKS_SERVICE_ACCOUNT=

# The decisioning service, which holds the lead model (ADR-048). Empty scores in-process from
# the dev environment. To go through the service, start it with
#   uv run uvicorn cornerpin_decisioning.app:app --port 8200
# and set http://localhost:8200. Required outside local.
DECISIONING_URL=

# Web push stays off until both are set. For local testing, make a pair with
#   uv run python -m cornerpin.devtools vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Web app -> API (read by the Next.js server; the browser only talks to the web origin)
API_BASE_URL=http://localhost:8000

# Copy to .env for local development. Values here are for the local Docker services only.

# Owner role; used by Alembic to run migrations and by the seed.
DATABASE_URL=postgresql+psycopg://cornerpin:cornerpin@localhost:5434/cornerpin
# Non-owner role the API connects as (ADR-021). Locally the migration sets this password.
API_DATABASE_URL=postgresql+psycopg://cornerpin_api:cornerpin_api@localhost:5434/cornerpin

# The origin people use. Sign-in links and the API's Origin check use it.
WEB_ORIGIN=http://localhost:3300
# Signs OAuth state. Any value locally; required and secret elsewhere.
SECRET_KEY=local-development-only-not-a-secret

# Cloudflare's always-pass Turnstile test keys; refused outside local.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google sign-in stays off until both exist (ADR-008).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: smtp (Mailpit, compose.yaml) locally; resend in the cloud.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Outbox: inprocess runs it inside the API (local); off leaves it to Cloud Tasks (P1-09).
OUTBOX_RUNNER=inprocess

# Web app -> API (read by the Next.js server; the browser only talks to the web origin)
API_BASE_URL=http://localhost:8000

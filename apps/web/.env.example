# Web app settings (read by the Next.js server). Copy to apps/web/.env.local to override.

# The API, reached server-side; the browser only ever talks to the web origin.
API_BASE_URL=http://localhost:8000
# The public address, for absolute link-preview URLs. https://cornerpin.app in production.
SITE_URL=http://localhost:3300
# Satellite view on maps (ADR-018). Empty keeps it off. MapTiler keys are public by design and
# restricted by domain in MapTiler's dashboard.
MAPTILER_KEY=
